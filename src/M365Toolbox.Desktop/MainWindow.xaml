<Window x:Class="M365Toolbox.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:M365Toolbox.Desktop.Views"
        Title="M365Toolbox" Height="520" Width="880">
    <Grid>
        <TabControl>
            <TabItem Header="Login">
                <views:LoginView x:Name="LoginViewHost" />
            </TabItem>
            <TabItem Header="Phishing Response">
                <views:PhishingView x:Name="PhishingViewHost" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>

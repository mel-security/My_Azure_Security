<Window x:Class="M365Toolbox.Desktop.Views.TypedConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HardDelete confirmation" Height="170" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" Text="Type exactly: DELETE {Binding SearchName}"/>
        <TextBox Margin="0,10,0,10" Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Margin="0,0,8,0" Content="Cancel" Click="Cancel_Click"/>
            <Button Width="80" Content="Confirm" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

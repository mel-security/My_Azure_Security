<UserControl x:Class="M365Toolbox.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10">
        <TextBlock Text="UPN" />
        <TextBox Text="{Binding UserPrincipalName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
        <Button Content="Connect" Command="{Binding ConnectCommand}" Width="120" />
        <TextBlock Margin="0,8,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
